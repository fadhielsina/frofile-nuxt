# ── Data source ──────────────────────────────────────────────────────────
# static   = public site uses hardcoded data (shared/data/fallback.ts), no DB needed (default)
# database = read from the database below (hardcoded data becomes the backup if DB errors)
DATA_SOURCE=static

# ── Database ─────────────────────────────────────────────────────────────
# Provider: postgres | mysql | sqlite (default: sqlite — zero setup, good for local dev)
DB_PROVIDER=sqlite

# Used only when DB_PROVIDER=sqlite. Path to the sqlite file (auto-created).
DB_FILE=.data/frofile.sqlite

# Used when DB_PROVIDER=postgres or mysql. Either fill these individually...
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=frofile
DB_SSL=false

# ...or set a single connection string instead (takes priority over the
# individual fields above when present).
# Postgres example: postgres://user:password@host:5432/dbname
# MySQL example:    mysql://user:password@host:3306/dbname
DB_URL=

# ── Auth / sessions ─────────────────────────────────────────────────────
# Required in production. Any random string, at least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-this-to-a-random-32-char-minimum-secret

# ── Site ─────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_NAME=My Profile
